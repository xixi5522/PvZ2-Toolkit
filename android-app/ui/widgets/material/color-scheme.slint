// fork 修改：color-scheme 的数据源从编译器内置 SlintInternal 改为
// Monet global（../monet.slint，Rust 侧注入），由应用的
// 「跟随系统 / 浅色 / 深色」设置驱动，不再依赖 backend 的系统回调。

import { Monet } from "../monet.slint";

export global ColorSchemeSelector  {
    in property <ColorScheme> color-scheme: Monet.color-scheme;
}

archive tiny.dz
basedir corpus
file local\empty.bin 0 dz
file local\one.bin 0 dz
file local\two.bin 0 dz

options dz
isnotdefault 1
max_mem_usage -1
use_combuf 0
preprocess 1
trim_reference_factor 20
WinSize 16
Flags 1
OffsetTableSize 8
OffsetTables 3
OffsetContexts 3
RefLengthTableSize 7
RefLengthTables 1
RefOffsetTableSize 7
RefOffsetTables 3
BigMinMatch 15
